# ============================================================
# 知屿 · 环境配置
# 复制为 .env 后按需修改；所有项都有可运行的默认值。
# ============================================================

# ------------------------------------------------------------ app
APP_NAME=知屿
APP_ENV=development
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO
# 首次启动自动导入 samples/ 下的示例资料
AUTO_SEED=true
# 生产环境请改成具体前端域名，多个用英文逗号分隔
CORS_ORIGINS=*

# ------------------------------------------------------------ LLM
# auto: 有 LLM_API_KEY 就用在线模型，否则本地抽取式
# openai: 任意 OpenAI-compatible /chat/completions 端点
# mock: 强制离线
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 视觉模型名（用于图片/扫描页的语义描述）；留空则不启用 VLM。
# 视觉模型可与文本模型使用不同厂商：单独设置 BASE_URL / API_KEY 即可。
# 通义百炼示例：
# LLM_VISION_MODEL=qwen3-vl-plus
# LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_VISION_API_KEY=sk-...
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.15
ENABLE_LLM_RERANK=true
ENABLE_LLM_QUERY_ANALYSIS=true
ENABLE_LLM_CITATION_JUDGE=false

# ------------------------------------------------------- embeddings
# auto / hash: 本地确定性 hash embedding（默认，零依赖）
# openai: OpenAI-compatible /embeddings（OpenAI、SiliconFlow BGE、Qwen…）
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 通义百炼示例：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=10   # text-embedding-v3/v4 单次最多 10 条
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ------------------------------------------------------------ index
# auto: 优先 Chroma，失败回退本地 SQLite+NumPy
VECTOR_BACKEND=auto
CHROMA_COLLECTION=zhiyu_chunks
CHUNK_SIZE=720
CHUNK_OVERLAP=120
MAX_CHUNK_CHARS=1400

# -------------------------------------------------------- retrieval
DENSE_TOP_K=14
BM25_TOP_K=14
RETRIEVE_TOP_K=8
RERANK_TOP_N=6
MAX_SUBQUERIES=3
CONTEXT_TOKEN_BUDGET=3200
MAX_CONTEXT_CHUNKS=8
NEIGHBOR_EXPANSION=1
MIN_CONFIDENCE=0.46
RETRIEVAL_RETRY_CONFIDENCE=0.34
MIN_RELEVANCE=0.20

# ------------------------------------------------------------ cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.94

# ----------------------------------------------------------- vision
ENABLE_VLM=true
OCR_ENABLED=true
OCR_LANG=ch
# 如 tesseract 不在 PATH，可填写完整路径
TESSERACT_CMD=
VLM_MAX_IMAGES_PER_DOC=6

# ---------------------------------------------------------- uploads
MAX_UPLOAD_MB=30

# ------------------------------------------------------------- auth
# 网页 API 的 Bearer Token；留空表示本机开放
DASHBOARD_TOKEN=
